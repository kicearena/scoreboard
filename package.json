{
  "name": "@kicearena/scoreboard",
  "version": "0.1.3",
  "type": "module",
  "description": "Controlled scoreboard rows, cells, controls and reveal presentation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kicearena/scoreboard.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/api.md",
    "docs/images"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/scoreboard.css"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.demo.json && prettier --check .",
    "demo": "vite --config vite.demo.config.ts --host 127.0.0.1",
    "demo:build": "vite build --config vite.demo.config.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@types/node": "25.9.1",
    "prettier": "3.8.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "vite": "7.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "lightningcss": "1.32.0",
    "postcss": "8.5.15"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.562.0"
  },
  "peerDependencies": {
    "react": "^19.2.3"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kicearena/scoreboard#readme",
  "bugs": {
    "url": "https://github.com/kicearena/scoreboard/issues"
  }
}
